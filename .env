PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=qwas
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PGDATABASE=qwas
PG_POOL_MAX=20
PG_POOL_MIN=2

# JWT — сгенерируй через: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_64_BYTE_HEX
JWT_TTL=30d
BCRYPT_ROUNDS=10

# Upload
UPLOAD_DIR=uploads
CHUNK_DIR=uploads/chunks
MAX_FILE_SIZE=52428800
MAX_CHUNK_SIZE=5242880

# Опционально — Redis для pub/sub между инстансами
REDIS_URL=

# Stories
STORY_TTL_HOURS=24

# CORS
CORS_ORIGIN=*
